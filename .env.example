# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# Database (used directly by docker-compose for the db container,
# and combined into DATABASE_URL for the backend)
POSTGRES_USER=acmeflow
POSTGRES_PASSWORD=acmeflow
POSTGRES_DB=acmeflow
DATABASE_URL=postgresql+psycopg://acmeflow:acmeflow@localhost:5432/acmeflow

# LLM provider abstraction: "anthropic" or "google"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

# Embeddings (used by the RAG pipeline)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=acmeflow-agent

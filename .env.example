# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
APP_VERSION=0.1.0
# Origins allowed to call the API from a browser (JSON list).
# The app's own frontend. Each shop's widget origins are not listed here: they live on the
# tenant (`tenants.allowed_origins`) and are checked per request.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = ignore the header).
# Rate limits count per client address, so a wrong value either lets anyone dodge them or
# puts every visitor behind the proxy in one bucket.
TRUSTED_PROXY_COUNT=0

# Database (used directly by docker-compose for the db container,
# and combined into DATABASE_URL for the backend). The db container publishes on
# host port 5433 (not 5432) to avoid colliding with a native Postgres install.
POSTGRES_USER=mewflow
POSTGRES_PASSWORD=mewflow
POSTGRES_DB=mewflow
DATABASE_URL=postgresql+psycopg://mewflow:mewflow@localhost:5433/mewflow

# LLM provider abstraction: "anthropic", "google", or "ollama"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro
# Free, runs locally, no API key — requires `ollama pull qwen2.5:7b-instruct` and
# `ollama serve` on the host first. Ignored unless LLM_PROVIDER=ollama.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (used by the RAG pipeline): "google" or "ollama"
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
# Requires `ollama pull nomic-embed-text`. Ignored unless EMBEDDING_PROVIDER=ollama.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Observability (self-hosted Langfuse — see the `langfuse-*` services in
# docker-compose.yml). These public/secret key defaults match the local-dev
# bootstrap values docker-compose seeds the Langfuse project with via
# LANGFUSE_INIT_*, so tracing works out of the box: `docker compose up`,
# flip LANGFUSE_TRACING_ENABLED to true, open http://localhost:3000.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-mewflow-local
LANGFUSE_SECRET_KEY=sk-lf-mewflow-local-dev-only
LANGFUSE_HOST=http://localhost:3000

# Secrets for sessions and for the audit hashes. Local environments fall back to a public dev key
# (and the audit hashes to the session key); any other environment must set BOTH, each at least
# 32 characters and different from each other, or the API refuses to start.
# SESSION_SIGNING_KEY=
# AUDIT_HMAC_KEY=
# Encrypts credentials kept in the database (a tenant's SMTP password). A Fernet key; generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# Seconds a shop's configuration (allowed origins, scope overrides) may be served from memory before
# it is read again; a change made in the back office applies at once on the instance that made it.
# TENANT_CONFIG_TTL_SECONDS=60

# The back office API (/api/admin) has a placeholder login: anyone may ask for any role. It is
# mounted only when this is true AND APP_ENV is a local environment. Never in a deployment.
# ADMIN_API_ENABLED=true

# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# Database (used directly by docker-compose for the db container,
# and combined into DATABASE_URL for the backend). The db container publishes on
# host port 5433 (not 5432) to avoid colliding with a native Postgres install.
POSTGRES_USER=acmeflow
POSTGRES_PASSWORD=acmeflow
POSTGRES_DB=acmeflow
DATABASE_URL=postgresql+psycopg://acmeflow:acmeflow@localhost:5433/acmeflow

# LLM provider abstraction: "anthropic", "google", or "ollama"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro
# Free, runs locally, no API key — requires `ollama pull qwen2.5:7b-instruct` and
# `ollama serve` on the host first. Ignored unless LLM_PROVIDER=ollama.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (used by the RAG pipeline): "google" or "ollama"
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
# Requires `ollama pull nomic-embed-text`. Ignored unless EMBEDDING_PROVIDER=ollama.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=acmeflow-agent
